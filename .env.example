# Token del bot de Discord (Developer Portal -> Bot -> Reset Token).
# Necesita el Privileged Gateway Intent "Server Members Intent" activado,
# y el permiso "Manage Guild" dentro del servidor.
DISCORD_BOT_TOKEN=

# ID del servidor (guild) de Discord de OLD STATE.
DISCORD_GUILD_ID=

# URL base del panel web (sin barra final) — ahí vive el endpoint
# /api/rewards_invites_record.php que recibe cada nueva invitación.
PANEL_WEB_URL=https://oldstate.sub-yorkhost.fr
