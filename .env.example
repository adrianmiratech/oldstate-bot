# Token del bot de Discord (Developer Portal -> Bot -> Reset Token).
# Necesita el Privileged Gateway Intent "Server Members Intent" activado,
# y el permiso "Manage Guild" dentro del servidor.
DISCORD_BOT_TOKEN=

# ID del servidor (guild) de Discord de OLD STATE.
DISCORD_GUILD_ID=

# URL base del panel web (sin barra final) — ahí vive el endpoint
# /api/rewards_invites_record.php que recibe cada nueva invitación.
PANEL_WEB_URL=https://oldstate.sub-yorkhost.fr

# Canal donde se mantiene el embed en vivo de "quién tiene cada rol" (ver
# ROSTER_ROLE_NAMES en el código) -- puede estar en cualquiera de los dos
# servidores, solo hace falta invitar al bot ahí con permiso para
# enviar/editar mensajes en ese canal.
ROSTER_CHANNEL_ID=1511363696964800563

# Segundo servidor de Discord a comparar con DISCORD_GUILD_ID: si alguien
# tiene un rol de staff en uno mientras que en el otro no, se le añade el
# que le falte. El bot necesita estar invitado también aquí, con su rol por
# encima de todos los roles de ROSTER_ROLE_NAMES.
SECOND_GUILD_ID=1381245443505393705

# Canal donde el staff escribe sus ausencias en texto libre (ej. "Del 10/09
# al 20/09 - Motivo: viaje familiar"). El bot analiza cada mensaje para
# sacar fecha de inicio, fin y motivo, y lo registra en la web.
ABSENCE_CHANNEL_ID=1381245444725932054

# Canal de sugerencias de la comunidad -- cada mensaje se registra en la
# web (/panel/sugerencias).
SUGGESTION_CHANNEL_ID=1522732946979553411
